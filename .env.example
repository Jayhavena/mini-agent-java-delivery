# Any OpenAI-compatible chat-completions endpoint can be used.
# DeepSeek example (default):
LLM_API_KEY=sk-your-key-here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# Optional runtime knobs
LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=1024
AGENT_MAX_STEPS=8
AGENT_MAX_TOOL_ROUNDS=6
AGENT_MAX_PARSE_RETRIES=2
AGENT_CONTEXT_TOKEN_BUDGET=6000
AGENT_KEEP_RECENT_MESSAGES=12
AGENT_MAX_SUMMARY_CHARS=4000
MINI_AGENT_DATA_DIR=./data

# The program also accepts DEEPSEEK_API_KEY as a fallback for LLM_API_KEY.
