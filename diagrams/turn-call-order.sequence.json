    "views": [
      {
        "id": "assemble",
        "label": "① 收输入并组装 context",
        "focus": [
          "cli",
          "runtime",
          "context",
          "store"
        ],
        "note": "AgentRuntime.chat 先把用户消息落盘，再让 ContextManager 拼出 system + 最近原文。"
      },
      {
        "id": "reason",
        "label": "② 调模型并解析",
        "focus": [
          "runtime",
          "llm",
          "parser"
        ],
        "note": "OpenAiCompatibleClient 走 HTTP，AgentOutputParser 把 JSON envelope 拆成 final / tool_call。"
      },
      {
        "id": "loop",
        "label": "③ 工具结果回灌后回到 ②",
        "focus": [
          "runtime",
          "tools",
          "store",
          "context"
        ],
        "note": "ToolResult 写入 session 后立刻进入下一 step，直到 final 或撞到 maxSteps / maxToolRounds。"
      }
    ]
  },
